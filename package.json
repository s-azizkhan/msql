{
  "name": "m-sql",
  "version": "0.1.0",
  "description": "Interactive SQL CLI and MCP server for Metabase. Query any Metabase database from the terminal or from AI agents (Claude, Cursor) without direct DB credentials.",
  "keywords": [
    "metabase",
    "sql",
    "cli",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "claude",
    "claude-code",
    "cursor",
    "ai-agent",
    "sql-client",
    "terminal",
    "database",
    "postgres",
    "mysql"
  ],
  "author": "S.Aziz Khan (https://justaziz.com)",
  "homepage": "https://github.com/s-azizkhan/msql#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/s-azizkhan/msql.git"
  },
  "bugs": {
    "url": "https://github.com/s-azizkhan/msql/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "bin": {
    "msql": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.8.4",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "better-sqlite3": "^12.4.1",
    "chalk": "^5.6.2",
    "cli-table3": "^0.6.5",
    "commander": "^14.0.0",
    "ora": "^8.2.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.5.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
